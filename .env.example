# Copy to .env and adjust. .env is gitignored.

# ---- translation ----
# off | gloss | command | http
SACHNOI_TRANSLATE_MODE=off
# Used when mode=command. The script gets one UTF-8 chunk on stdin and must
# print the Vietnamese text on stdout.
SACHNOI_MT_COMMAND=
# Used when mode=http. Expects {"text": "..."} and returns {"text": "..."}.
SACHNOI_MT_URL=
SACHNOI_MT_MODEL=
SACHNOI_MT_BATCH_CHARS=3000
SACHNOI_MT_TIMEOUT=120

# ---- TTS (VieNeu-TTS) ----
SACHNOI_TTS_BACKEND=vieneu
# VieNeu-TTS speaker ids, e.g. VN-01 .. VN-10. Map them in docs/tts.md.
SACHNOI_TTS_SPEAKER=VN-01
SACHNOI_TTS_SPEED=1.0
SACHNOI_TTS_MAX_CHARS=400
SACHNOI_TTS_DEVICE=auto
VIENEU_MODEL_DIR=models/vieneu

# ---- audio packaging ----
SACHNOI_SAMPLE_RATE=22050
SACHNOI_M4B_BITRATE=64k
SACHNOI_CHAPTER_GAP=0.6
SACHNOI_COVER_WIDTH=1400
SACHNOI_COVER_HEIGHT=2100